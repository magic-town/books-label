{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 fase_2/catalogo_base.py --config fase_2/config/<config_catalogo.json>",

    "pdf_input":   "libros/playa_26.pdf",
    "excel_input": "precios/lista_playa.xlsx",
    "pdf_output":  "salidas/catalogo_playa_precios.pdf",

    "paginas_prueba": false,

    "id_proveedor": "PS",

    "presentaciones": [
        {"path": "../imagenes/logos/portada_01.pdf", "posicion": 2},
        {"path": "../imagenes/logos/portada_02.pdf", "posicion": false},
        {"path": "../imagenes/logos/portada_03.pdf", "posicion": false},
        {"path": "../imagenes/logos/portada_04.pdf", "posicion": false},
        {"path": "../imagenes/logos/portada_05.pdf", "posicion": false}
    ],

    "logo_activo":        true,
    "logo_path":          "../imagenes/logos/logo_bz.png",
    "logo_x_pt":          50,
    "logo_y_pt":          634,
    "logo_ancho_pt":      90,
    "logo_alto_pt":       90,
    "logo_transparencia": 0.85,

    "etiqueta_font":        "Helvetica-BoldOblique",
    "etiqueta_font_size":   13,
    "etiqueta_color_rgb":   [0, 0, 1],
    "etiqueta_offset_x_pt": 35,
    "etiqueta_offset_y_pt": 26.5,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 250,
    "psm": 11,

    "ocr_doble_pasada": true,

    "contraste":     3.0,
    "nitidez":       2.5,
    "ocr_grayscale": true,
    "ocr_invertir":  false,

    "fuzzy_activo": false,
    "fuzzy_umbral": 80
}