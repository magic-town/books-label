{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 fase_2/catalogo_base.py --config fase_2/config/<config_catalogo.json>",

    "pdf_input":   "libros/licencias_26.pdf",
    "excel_input": "precios/lista_licencias.xlsx",
    "pdf_output":  "salida/licencias_precios.pdf",

    "paginas_prueba": false,

    "id_proveedor": "PS",

    "presentaciones": [
        {"path": "../imagenes/logos/portada_01.pdf", "posicion": 2},
        {"path": "../imagenes/logos/portada_02.pdf", "posicion": 3},
        {"path": "../imagenes/logos/portada_03.pdf", "posicion": 80},
        {"path": "../imagenes/logos/portada_04.pdf", "posicion": 160},
        {"path": "../imagenes/logos/portada_05.pdf", "posicion": -1}
    ],

    "logo_activo":        true,
    "logo_path":          "../imagenes/logos/logo_bz.png",
    "logo_x_pt":          31,
    "logo_y_pt":          625,
    "logo_ancho_pt":      90,
    "logo_alto_pt":       90,
    "logo_transparencia": 0.85,

    "etiqueta_font":        "Helvetica-BoldOblique",
    "etiqueta_font_size":   12,
    "etiqueta_color_rgb":   [0, 0.58, 1],
    "etiqueta_offset_x_pt": 5,
    "etiqueta_offset_y_pt": 43.5,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 300,
    "psm": 6,

    "ocr_doble_pasada": true,

    "contraste":     2.5,
    "nitidez":       2.0,
    "ocr_grayscale": true,
    "ocr_invertir":  false,

    "fuzzy_activo": false,
    "fuzzy_umbral": 80
}