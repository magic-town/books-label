{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 fase_2/catalogo_base.py --config fase_2/config/<config_catalogo.json>",

    "pdf_input":   "libros/kids_ropa.pdf",
    "excel_input": "precios/lista_kids_ropa.xlsx",
    "pdf_output":  "salidas/kids_ropa_precios.pdf",

    "paginas_prueba": false,

    "id_proveedor": "PS",

    "presentaciones": [
        {"path": "../imagenes/logos/portada_01.pdf", "posicion": 2},
        {"path": "../imagenes/logos/portada_02.pdf", "posicion": 3},
        {"path": "../imagenes/logos/portada_03.pdf", "posicion": 40},
        {"path": "../imagenes/logos/portada_04.pdf", "posicion": 70},
        {"path": "../imagenes/logos/portada_05.pdf", "posicion": -1}
    ],

    "logo_activo":        true,
    "logo_path":          "../imagenes/logos/logo_bz.png",
    "logo_x_pt":          451,
    "logo_y_pt":          592,
    "logo_ancho_pt":      85,
    "logo_alto_pt":       85,
    "logo_transparencia": 0.85,

    "etiqueta_font":        "Helvetica-BoldOblique",
