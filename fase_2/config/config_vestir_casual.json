{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 fase_2/catalogo_base.py --config fase_2/config/<config_catalogo.json>",

    "pdf_input":   "libros/vestir_casual.pdf",
    "excel_input": "precios/lista_vestir_casual.xlsx",
    "pdf_output":  "salidas/vestir_casual_precios.pdf",

    "paginas_prueba": false,

    "id_proveedor": "PS",

    "presentaciones": [
        {"path": "../imagenes/logos/portada_01.pdf", "posicion": 2},
        {"path": "../imagenes/logos/portada_02.pdf", "posicion": 3},
        {"path": "../imagenes/logos/portada_03.pdf", "posicion": 70},
        {"path": "../imagenes/logos/portada_04.pdf", "posicion": 150},
        {"path": "../imagenes/logos/portada_05.pdf", "posicion": -1}
    ],

    "logo_activo":        true,
    "logo_path":          "../imagenes/logos/logo_bz.png",
    "logo_x_pt":          386,
    "logo_y_pt":          452,
    "logo_ancho_pt":      80,
    "logo_alto_pt":       80,
    "logo_transparencia": 0.85,

    "etiqueta_font":        "Helvetica-BoldOblique",
    "etiqueta_font_size":   14,
    "etiqueta_color_rgb":   [0, 0, 1],
    "etiqueta_offset_x_pt": 3.5,
    "etiqueta_offset_y_pt": 13,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 250,
    "psm": 11,

    "ocr_doble_pasada": true,

    "contraste":     3.0,
    "nitidez":       2.5,
    "ocr_grayscale": true,
    "ocr_invertir":  false,

    "fuzzy_activo": false,
    "fuzzy_umbral": 80
}