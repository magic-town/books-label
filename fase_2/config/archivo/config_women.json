    "etiqueta_offset_y_pt": -18,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 200,
    "psm": 6,

    "ocr_doble_pasada": true,

    "contraste":     2.5,
    "nitidez":       2,
    "ocr_grayscale": true,
    "ocr_invertir":  false,

    "fuzzy_activo": false,
    "fuzzy_umbral": 80
