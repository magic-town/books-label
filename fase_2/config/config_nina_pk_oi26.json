{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 fase_2/catalogo_base.py --config fase_2/config/<config_catalogo_temp.json>",
    
    "id_proveedor": "Pakar",
    
    "paginas_prueba": false,
    
    "ocr_rotacion_90":  false,
    "ocr_rotacion_270": false,
    
    "pdf_input":   "libros/nina_pk_oi26_rgb.pdf",
    "excel_input": "precios/lista_nina_oi26.xlsx",
    "pdf_output":  "salidas/nina_pk_oi26_precios.pdf",
    
    "presentaciones": [
        {"path": "../imagenes/logos/portada_01.pdf", "posicion": 2},
        {"path": "../imagenes/logos/portada_02.pdf", "posicion": 3},
        {"path": "../imagenes/logos/portada_03.pdf", "posicion": 4},
        {"path": "../imagenes/logos/portada_04.pdf", "posicion": 280},
        {"path": "../imagenes/logos/portada_05.pdf", "posicion": -1}
    ],
    
    "logo_activo":        true,
    "logo_path":          "../imagenes/logos/logo_blue.png",
    "logo_x_pt":          420,
    "logo_y_pt":          645,
    "logo_ancho_pt":      90,
    "logo_alto_pt":       90,
    "logo_transparencia": 0.90,
    
    "etiqueta_font":        "Helvetica-BoldOblique",
    "etiqueta_font_size":   8,
    "etiqueta_color_rgb":   [0, 0, 1],
    "etiqueta_offset_x_pt": -8,
    "etiqueta_offset_y_pt": -14,
    
    "id_longitud_min": 4,
    "id_longitud_max": 8,
    
    "dpi": 300,
    "psm": 6,
    
    "ocr_doble_pasada": true,
    
    "contraste":     2.5,
    "nitidez":       2.0,
    
    "ocr_grayscale": true,
    "ocr_invertir":  false,
    "fuzzy_activo": false,
    "fuzzy_umbral": 80
}