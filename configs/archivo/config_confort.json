{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 scripts/catalogo_base.py --config configs/<config_catalogo.json>",

    "pdf_input":   "libros/confort_26.pdf",
    "excel_input": "precios/lista_confort.xlsx",
    "pdf_output":  "salidas/confort_precios.pdf",

    "paginas_prueba": false,

    "presentaciones": [
        {"path": "imagenes/logos/portada_01.pdf", "posicion": 2},
        {"path": "imagenes/logos/portada_02.pdf", "posicion": 25},
        {"path": "imagenes/logos/portada_03.pdf", "posicion": 130},
        {"path": "imagenes/logos/portada_04.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_05.pdf", "posicion": -1}
    ],

    "etiqueta_font": "Helvetica-BoldOblique",
    "etiqueta_font_size": 13,
    "etiqueta_color_rgb": [0.89, 0.20, 0.23],
    "etiqueta_offset_x_pt": 0.0,
    "etiqueta_offset_y_pt": 4.0,

    "logo_activo": true,
    "logo_path": "imagenes/logos/logo_bz.png",
    "logo_x_pt": 220.0,
    "logo_y_pt": 502.0,
    "logo_ancho_pt": 95.0,
    "logo_alto_pt": 95.0,
    "logo_transparencia": 0.85,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 200,
    "psm": 6,

    "ocr_doble_pasada": true,

    "contraste": 2.5,
    "nitidez": 2.0,
    "ocr_grayscale": true,
    "ocr_invertir": false,

    "fuzzy_activo": false,
    "fuzzy_umbral": 80
}
