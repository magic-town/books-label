    "logo_alto_pt": 80.0,
    "logo_transparencia": 0.85,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 200,
    "psm": 6,

    "ocr_doble_pasada": false,

    "contraste": 3.5,
    "nitidez": 3.0,
    "ocr_grayscale": true,
    "ocr_invertir": false,

    "fuzzy_activo": false,
    "fuzzy_umbral": 80
