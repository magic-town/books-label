{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 scripts/catalogo_base.py --config configs/<config_catalogo.json>",

    "pdf_input":   "libros/jeans_PV26.pdf",
    "excel_input": "precios/lista_jeans.xlsx",
    "pdf_output":  "salidas/jeans_precios.pdf",

    "paginas_prueba": 20,

    "presentaciones": [
        {"path": "imagenes/logos/portada_01.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_02.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_03.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_04.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_05.pdf", "posicion": false}
    ],

    "etiqueta_font": "Helvetica-BoldOblique",
    "etiqueta_font_size": 14,
    "etiqueta_color_rgb": [0.89, 0.20, 0.23],
    "etiqueta_offset_x_pt": 0.0,
    "etiqueta_offset_y_pt": 48.0,

    "logo_activo": true,
    "logo_path": "imagenes/logos/logo_bz.png",
    "logo_x_pt": 405.0,
    "logo_y_pt": 706.0,
