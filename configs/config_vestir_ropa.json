{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 scripts/catalogo_base.py --config configs/<config_catalogo.json>",

    "pdf_input":   "libros/vestir_ropa.pdf",
    "excel_input": "precios/lista_vestir_ropa.xlsx",
    "pdf_output":  "salidas/vestir_ropa_precios.pdf",

    "paginas_prueba": 20,

    "presentaciones": [
        {"path": "imagenes/logos/portada_01.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_02.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_03.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_04.pdf", "posicion": false},
        {"path": "imagenes/logos/portada_05.pdf", "posicion": false}
    ],

    "logo_activo":        true,
    "logo_path":          "imagenes/logos/logo_bz.png",
    "logo_x_pt":          415,
    "logo_y_pt":          705,
    "logo_ancho_pt":      80,
    "logo_alto_pt":       80,
    "logo_transparencia": 0.85,

    "etiqueta_font":        "Helvetica-BoldOblique",
    "etiqueta_font_size":   12,
    "etiqueta_color_rgb":   [0.89, 0.2, 0.23],
    "etiqueta_offset_x_pt": -29,
    "etiqueta_offset_y_pt": 14,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 200,
    "psm": 6,

    "ocr_doble_pasada": false,

    "contraste":     2.5,
    "nitidez":       2,
    "ocr_grayscale": true,
    "ocr_invertir":  false,

    "fuzzy_activo": false,
    "fuzzy_umbral": 80
}