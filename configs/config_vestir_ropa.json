{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 scripts/catalogo_base.py --config configs/<config_catalogo.json>",

    "pdf_input":   "libros/vestir_ropa.pdf",
    "excel_input": "precios/lista_vestir_ropa.xlsx",
    "pdf_output":  "salidas/vestir_ropa_final.pdf",

    "paginas_prueba": false,

    "presentaciones": [
        {"path": "imagenes/logos/portada_01.pdf", "posicion": 1},
        {"path": "imagenes/logos/portada_02.pdf", "posicion": 10},
        {"path": "imagenes/logos/portada_03.pdf", "posicion": -1}
    ],

    "etiqueta_font": "Helvetica-Bold",
    "etiqueta_font_size": 12,
    "etiqueta_color_rgb": [1, 0.13, 0.69],
    "etiqueta_offset_x_pt": -29,
    "etiqueta_offset_y_pt": 14,

    "logo_activo": true,
    "logo_path": "imagenes/logos/logo_bz.png",
    "logo_x_pt": 496,
    "logo_y_pt": 544,
    "logo_ancho_pt": 80,
    "logo_alto_pt": 80,
    "logo_transparencia": 0.85,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 250,
    "psm": 11,

    "ocr_doble_pasada": false,

    "contraste": 2.5,
    "nitidez": 2,
    "ocr_grayscale": true,
    "ocr_invertir": false,

    "fuzzy_activo": false,
    "fuzzy_umbral": 80
}
