{
    "_comentario": "Configuración para Catalogo — Boutique Zepeda",
    "_uso": "python3 scripts/catalogo_base.py --config configs/<catalogo_26.json>",

    "pdf_input":   "libros/urbano_26.pdf",
    "excel_input": "precios/lista_urbano.xlsx",
    "pdf_output":  "salidas/urbano_test.pdf",

    "paginas_prueba": 3,

    "presentaciones": [
        {"path": "imagenes/logos/portada_01.pdf", "posicion": 2},
        {"path": "imagenes/logos/portada_02.pdf", "posicion": 300},
        {"path": "imagenes/logos/portada_03.pdf", "posicion": -1}
    ],
    
    "etiqueta_font": "Helvetica-BoldOblique",
    "etiqueta_font_size": 13,
    "etiqueta_color_rgb": [0.89, 0.2, 0.23],
    "etiqueta_offset_x_pt": -2.0,
    "etiqueta_offset_y_pt": 6.0,

    "logo_activo": true,
    "logo_path": "imagenes/logos/logo_bz.png",
    "logo_x_pt": 486.0,
    "logo_y_pt": 610.0,
    "logo_ancho_pt": 80.0,
    "logo_alto_pt": 80.0,
    "logo_transparencia": 0.85,

    "id_longitud_min": 4,
    "id_longitud_max": 8,

    "dpi": 200,
    "psm": 6,

    "ocr_doble_pasada": false,

    "contraste": 2.5,
    "nitidez": 2.0,
    "ocr_grayscale": true,
    "ocr_invertir": false,


    "fuzzy_activo": false,
    "fuzzy_umbral": 85
    }
